{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc --noEmit:*)"
    ],
    "deny": [
      "Read(./anchor-agentic/api/.dev.vars)",
      "Read(./anchor-agentic/web/.env)",
      "Read(./**/.env)",
      "Read(./**/.dev.vars)",
      "Read(./anchor-agentic/supabase/.temp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-legacy.mjs\""
          }
        ]
      }
    ]
  }
}
